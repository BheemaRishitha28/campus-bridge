# ==============================================================================
# CampusBridge — Environment Variables Configuration
# ==============================================================================

# Supabase Project Connection (Optional for local evaluation; required for cloud sync)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Application Site URL (Used for OAuth redirects e.g. Google and GitHub)
# In development: http://localhost:5173
# In production: https://campusbridge.university.edu
VITE_SITE_URL=http://localhost:5173

# Note: If Supabase credentials are not provided, CampusBridge automatically operates
# in its comprehensive offline evaluation mode with persistent local storage and
# pre-verified demonstration profiles (Dr. Arvind Sharma, Student A, Student B, Student C).
